# --- Database ---
DATABASE_URL=postgresql+psycopg://ekip:ekip@postgres:5432/ekip

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM (local, via Ollama — no API key needed) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_DIM=384

# --- LangSmith tracing (optional — off unless you set these) ---
# Free tier available at https://smith.langchain.com. Leave TRACING_V2=false
# (or unset) to skip tracing entirely — the app works fine without it, using
# its own built-in RetrievalTrace records instead.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ekip

# --- Retrieval tuning ---
LEXICAL_TOP_K=20
DENSE_TOP_K=20
FUSION_TOP_K=10
RERANK_TOP_K=5
MIN_EVIDENCE_SCORE=0.15
